<UserControl x:Class="LaserCollisionIn3DObjects.Wpf.Features.SourceCompletion.Views.SourceCompletionWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:helix="http://helix-toolkit.org/wpf"
             xmlns:sourceCompletionDomain="clr-namespace:LaserCollisionIn3DObjects.Domain.SourceCompletion;assembly=LaserCollisionIn3DObjects.Domain"
             mc:Ignorable="d">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="500"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Source Completion" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,10"/>

                <TextBlock Text="Projected Source" FontWeight="SemiBold"/>
                <ComboBox ItemsSource="{Binding SourceCompletionWorkspace.AvailableProjectedSources}"
                          SelectedItem="{Binding SourceCompletionWorkspace.SelectedProjectedSourceInput}"
                          DisplayMemberPath="DisplayText"
                          Margin="0,4,0,10"/>

                <TextBlock Text="Target Collision Scene" FontWeight="SemiBold"/>
                <ComboBox ItemsSource="{Binding SourceCompletionWorkspace.TargetCollisionScenes}"
                          SelectedItem="{Binding SourceCompletionWorkspace.SelectedTargetCollisionScene}"
                          DisplayMemberPath="Name"
                          Margin="0,4,0,6"/>
                <Button Content="Refresh Sources" Command="{Binding SourceCompletionWorkspace.RefreshSourcesCommand}" Margin="0,0,0,10"/>

                <TextBlock Text="Completion Method" FontWeight="SemiBold"/>
                <ComboBox ItemsSource="{Binding SourceCompletionWorkspace.CompletionMethods}"
                          SelectedItem="{Binding SourceCompletionWorkspace.SelectedCompletionMethod}"
                          Margin="0,4,0,10"/>

                <UniformGrid Columns="2" Margin="0,0,0,10">
                    <StackPanel Margin="3"><TextBlock Text="Angular Step (deg)"/><TextBox Text="{Binding SourceCompletionWorkspace.AngularStepDegrees}"/></StackPanel>
                    <StackPanel Margin="3"><TextBlock Text="Gap Threshold (deg)"/><TextBox Text="{Binding SourceCompletionWorkspace.GapThresholdDegrees}"/></StackPanel>
                </UniformGrid>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <CheckBox IsChecked="{Binding SourceCompletionWorkspace.IncludeOriginalRays}" VerticalAlignment="Center"/>
                    <TextBlock Text="Include Original Rays" Margin="6,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Text="Max Synthetic Rays (optional)"/>
                <TextBox Text="{Binding SourceCompletionWorkspace.MaxSyntheticRaysText}" Margin="0,4,0,10"/>

                <StackPanel Margin="0,0,0,10">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SourceCompletionWorkspace.SelectedCompletionMethod}" Value="{x:Static sourceCompletionDomain:SourceCompletionMethod.Mirror}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="Mirror Axis Degrees"/>
                    <TextBox Text="{Binding SourceCompletionWorkspace.MirrorAxisDegrees}" Margin="0,4,0,0"/>
                </StackPanel>

                <WrapPanel Margin="0,0,0,10">
                    <Button Content="Analyze Coverage" Command="{Binding SourceCompletionWorkspace.AnalyzeCoverageCommand}" Margin="0,0,8,8"/>
                    <Button Content="Generate Completed Source" Command="{Binding SourceCompletionWorkspace.GenerateCompletedSourceCommand}" Margin="0,0,8,8"/>
                    <Button Content="Add Completed Source to Collision" Command="{Binding SourceCompletionWorkspace.AddCompletedSourceToCollisionCommand}" Margin="0,0,8,8"/>
                </WrapPanel>

                <GroupBox Header="Completed Sources" Margin="0,0,0,10">
                    <StackPanel>
                        <ListBox ItemsSource="{Binding SourceCompletionWorkspace.CompletedSources}"
                                 SelectedItem="{Binding SourceCompletionWorkspace.SelectedCompletedSource}"
                                 DisplayMemberPath="Name"
                                 Height="120"/>
                        <TextBox Text="{Binding SourceCompletionWorkspace.SelectedCompletedSourceName}" Margin="0,6,0,6"/>
                        <Button Content="Remove Selected Completed Source" Command="{Binding SourceCompletionWorkspace.RemoveSelectedCompletedSourceCommand}"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Coverage Intervals" Margin="0,0,0,10">
                    <DataGrid ItemsSource="{Binding SourceCompletionWorkspace.CoverageIntervals}" AutoGenerateColumns="False" CanUserAddRows="False" Height="180">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Start" Binding="{Binding StartDegrees, StringFormat=F2}" Width="*"/>
                            <DataGridTextColumn Header="End" Binding="{Binding EndDegrees, StringFormat=F2}" Width="*"/>
                            <DataGridTextColumn Header="Samples" Binding="{Binding SampleCount}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>

                <GroupBox Header="Gap Intervals" Margin="0,0,0,10">
                    <DataGrid ItemsSource="{Binding SourceCompletionWorkspace.GapIntervals}" AutoGenerateColumns="False" CanUserAddRows="False" Height="180">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Start" Binding="{Binding StartDegrees, StringFormat=F2}" Width="*"/>
                            <DataGridTextColumn Header="End" Binding="{Binding EndDegrees, StringFormat=F2}" Width="*"/>
                            <DataGridTextColumn Header="Width" Binding="{Binding WidthDegrees, StringFormat=F2}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>

                <TextBlock Text="{Binding SourceCompletionWorkspace.StatusMessage}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                <TextBlock Text="{Binding SourceCompletionWorkspace.CompletionSummary}" TextWrapping="Wrap" Margin="0,4,0,0" FontWeight="SemiBold"/>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Text="Source Completion Preview" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <helix:HelixViewport3D x:Name="SourceCompletionViewport" Grid.Row="1" ShowCoordinateSystem="True" ShowViewCube="True" ZoomExtentsWhenLoaded="True">
                <helix:HelixViewport3D.Camera>
                    <PerspectiveCamera Position="0,-30,20" LookDirection="0,30,-20" UpDirection="0,0,1" FieldOfView="45"/>
                </helix:HelixViewport3D.Camera>
                <helix:SunLight/>
            </helix:HelixViewport3D>
            <StackPanel Grid.Row="2" Margin="0,8,0,0">
                <TextBlock Text="Original projected points: red/orange" Foreground="#555"/>
                <TextBlock Text="Completed synthetic points: green" Foreground="#555"/>
                <TextBlock Text="Preview shows source initial points only. Ray lines are not rendered here." Foreground="#555" TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
