<UserControl x:Class="LaserCollisionIn3DObjects.Wpf.Views.CollisionWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:h="http://helix-toolkit.org/wpf"
             xmlns:conv="clr-namespace:LaserCollisionIn3DObjects.Wpf.Converters"
             xmlns:views="clr-namespace:LaserCollisionIn3DObjects.Wpf.Views"
             mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:FlexibleNumericConverter x:Key="FlexibleNumericConverter" />
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="430" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Padding="12" BorderBrush="#D8D8D8" BorderThickness="0,0,1,0" Background="#FAFAFA" IsEnabled="{Binding IsCollisionEditingEnabled}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Scene Editor" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,10" />

                    <!-- existing Scenes + Prisms unchanged -->
                    <GroupBox Header="Scenes" Margin="0,0,0,8" Padding="8">
                        <StackPanel>
                            <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="Name" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding NewSceneName, UpdateSourceTrigger=PropertyChanged}"/></Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6"><Button Content="Create Scene" Command="{Binding CreateSceneCommand}" Width="110" Margin="0,0,8,0"/><Button Content="Delete Selected" Command="{Binding DeleteSelectedSceneCommand}" Width="120"/></StackPanel>
                            <ListBox ItemsSource="{Binding CollisionScenes}" SelectedItem="{Binding SelectedScene}" Height="120" DisplayMemberPath="Name"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Prisms" Margin="0,0,0,8" Padding="8">
                        <StackPanel>
                            <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="Name" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding NewPrismName}"/></Grid>
                            <UniformGrid Columns="3" Margin="0,0,0,6"><StackPanel Margin="2"><TextBlock Text="Position X (m)"/><TextBox Text="{Binding NewPrismPosX, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleNumericConverter}}"/></StackPanel><StackPanel Margin="2"><TextBlock Text="Position Y (m)"/><TextBox Text="{Binding NewPrismPosY, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleNumericConverter}}"/></StackPanel><StackPanel Margin="2"><TextBlock Text="Position Z (m)"/><TextBox Text="{Binding NewPrismPosZ, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleNumericConverter}}"/></StackPanel></UniformGrid>
                            <UniformGrid Columns="3" Margin="0,0,0,6"><StackPanel Margin="2"><TextBlock Text="Rotation X (deg)"/><TextBox Text="{Binding NewPrismRotX, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleNumericConverter}}"/></StackPanel><StackPanel Margin="2"><TextBlock Text="Rotation Y (deg)"/><TextBox Text="{Binding NewPrismRotY, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleNumericConverter}}"/></StackPanel><StackPanel Margin="2"><TextBlock Text="Rotation Z (deg)"/><TextBox Text="{Binding NewPrismRotZ, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleNumericConverter}}"/></StackPanel></UniformGrid>
                            <UniformGrid Columns="3" Margin="0,0,0,6"><StackPanel Margin="2"><TextBlock Text="Size X (m)"/><TextBox Text="{Binding NewPrismSizeX, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleNumericConverter}}"/></StackPanel><StackPanel Margin="2"><TextBlock Text="Size Y (m)"/><TextBox Text="{Binding NewPrismSizeY, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleNumericConverter}}"/></StackPanel><StackPanel Margin="2"><TextBlock Text="Size Z (m)"/><TextBox Text="{Binding NewPrismSizeZ, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleNumericConverter}}"/></StackPanel></UniformGrid>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Button Content="Add Prism" Command="{Binding AddPrismCommand}" Width="100" Margin="0,0,8,0"/>
                                <Button Content="Remove Selected" Command="{Binding RemoveSelectedPrismCommand}" Width="120" Margin="0,0,8,0"/>
                                <Button Content="Delete All Prisms" Command="{Binding RemoveAllPrismsCommand}" Width="125"/>
                            </StackPanel>  

                            <GroupBox Header="Panel Array" Padding="6" Margin="0,2,0,8">
                              <StackPanel>
                                <Grid Margin="0,0,0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Placement"/><ComboBox Grid.Column="1" ItemsSource="{Binding PrismArrayPlacementModes}" SelectedItem="{Binding SelectedPrismArrayPlacementMode}"/></Grid>
                                <StackPanel Visibility="{Binding IsPrismArrayPolar, Converter={StaticResource BoolToVisibility}}">
                                  <UniformGrid Columns="2"><StackPanel Margin="2"><TextBlock Text="Radius (m)"/><TextBox Text="{Binding NewPrismArrayRadius, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleNumericConverter}}"/></StackPanel><StackPanel Margin="2"><TextBlock Text="Array Z (m)"/><TextBox Text="{Binding NewPrismArrayZ, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleNumericConverter}}"/></StackPanel></UniformGrid>
                                </StackPanel>
                                <StackPanel Visibility="{Binding IsPrismArrayAngularRange, Converter={StaticResource BoolToVisibility}}">
                                  <UniformGrid Columns="2"><StackPanel Margin="2"><TextBlock Text="Start Angle (deg)"/><TextBox Text="{Binding NewPrismArrayStartAngle, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleNumericConverter}}"/></StackPanel><StackPanel Margin="2"><TextBlock Text="End Angle (deg)"/><TextBox Text="{Binding NewPrismArrayEndAngle, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleNumericConverter}}"/></StackPanel></UniformGrid>
                                  <TextBlock Text="{Binding NewPrismSizeY, StringFormat=Panel Width (SizeY): {0:F3}, Mode=OneWay}"/>
                                  <TextBlock Text="{Binding CalculatedPrismArrayCount, StringFormat=Calculated Panel Count: {0}, Mode=OneWay}"/>
                                  <TextBlock Text="{Binding PanelAngularFootprintDegrees, StringFormat=Panel Angular Footprint: {0:F3}°, Mode=OneWay}"/>
                                </StackPanel>
                                <StackPanel Visibility="{Binding IsPrismArrayAngularStep, Converter={StaticResource BoolToVisibility}}">
                                  <UniformGrid Columns="2"><StackPanel Margin="2"><TextBlock Text="Start Angle (deg)"/><TextBox Text="{Binding NewPrismArrayStartAngle, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleNumericConverter}}"/></StackPanel><StackPanel Margin="2"><TextBlock Text="Angle Between Panels (deg)"/><TextBox Text="{Binding NewPrismArrayStepAngle, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleNumericConverter}}"/></StackPanel></UniformGrid>
                                </StackPanel>
                                <StackPanel Visibility="{Binding IsPrismArrayCartesian, Converter={StaticResource BoolToVisibility}}"><TextBlock Text="Side Length (m)"/><TextBox Text="{Binding NewPrismArrayLength, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleNumericConverter}}"/><TextBlock Text="Array Z (m)"/><TextBox Text="{Binding NewPrismArrayZ, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleNumericConverter}}"/></StackPanel>
                                <Grid Margin="0,5,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0" Orientation="Horizontal" Visibility="{Binding IsPrismArrayCountVisible, Converter={StaticResource BoolToVisibility}}"><TextBlock Text="Panel Count" VerticalAlignment="Center" Margin="0,0,5,0"/><TextBox Width="65" Text="{Binding NewPrismArrayCount}"/></StackPanel><Button Grid.Column="1" Content="Add Panel Array" Command="{Binding AddPrismArrayCommand}" Padding="10,4"/></Grid>
                              </StackPanel>
                            </GroupBox>

                           
                            <DataGrid ItemsSource="{Binding Prisms}" SelectedItem="{Binding SelectedPrism}" AutoGenerateColumns="False" CanUserAddRows="False" Height="130">
                                <DataGrid.Columns><DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Sx" Binding="{Binding SizeX}" Width="45"/><DataGridTextColumn Header="Sy" Binding="{Binding SizeY}" Width="45"/><DataGridTextColumn Header="Sz" Binding="{Binding SizeZ}" Width="45"/></DataGrid.Columns>
                            </DataGrid>
                            <GroupBox Header="Selected Prism" Margin="0,8,0,0" Padding="6">
                                <StackPanel>
                                    <TextBlock Text="No prism selected." Visibility="{Binding HasNoPrismSelection, Converter={StaticResource BoolToVisibility}}"/>
                                    <StackPanel Visibility="{Binding IsSelectedPrismEditable, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="Position (m)"/>
                                        <UniformGrid Columns="3" Margin="0,0,0,6"><StackPanel Margin="2"><TextBlock Text="X"/><TextBox Text="{Binding SelectedPrismEditPositionX, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleNumericConverter}}"/></StackPanel><StackPanel Margin="2"><TextBlock Text="Y"/><TextBox Text="{Binding SelectedPrismEditPositionY, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleNumericConverter}}"/></StackPanel><StackPanel Margin="2"><TextBlock Text="Z"/><TextBox Text="{Binding SelectedPrismEditPositionZ, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleNumericConverter}}"/></StackPanel></UniformGrid>
                                        <TextBlock Text="Rotation (deg)"/>
                                        <UniformGrid Columns="3" Margin="0,0,0,6"><StackPanel Margin="2"><TextBlock Text="X"/><TextBox Text="{Binding SelectedPrismEditRotationX, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleNumericConverter}}"/></StackPanel><StackPanel Margin="2"><TextBlock Text="Y"/><TextBox Text="{Binding SelectedPrismEditRotationY, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleNumericConverter}}"/></StackPanel><StackPanel Margin="2"><TextBlock Text="Z"/><TextBox Text="{Binding SelectedPrismEditRotationZ, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleNumericConverter}}"/></StackPanel></UniformGrid>
                                        <TextBlock Text="Size (m)"/>
                                        <UniformGrid Columns="3" Margin="0,0,0,6"><StackPanel Margin="2"><TextBlock Text="X"/><TextBox Text="{Binding SelectedPrismEditSizeX, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleNumericConverter}}"/></StackPanel><StackPanel Margin="2"><TextBlock Text="Y"/><TextBox Text="{Binding SelectedPrismEditSizeY, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleNumericConverter}}"/></StackPanel><StackPanel Margin="2"><TextBlock Text="Z"/><TextBox Text="{Binding SelectedPrismEditSizeZ, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleNumericConverter}}"/></StackPanel></UniformGrid>
                                        <Button Content="Apply Prism Changes" Command="{Binding ApplySelectedPrismChangesCommand}" Width="150"/>
                                    </StackPanel>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Axisymmetric Light Sources" Margin="0,0,0,8" Padding="8">
                        <StackPanel>
                            <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="Name" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding NewLightSourceName}"/></Grid>
                            <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="Type" VerticalAlignment="Center"/><ComboBox Grid.Column="1" ItemsSource="{Binding LightSourceKinds}" SelectedItem="{Binding NewLightSourceKind}"/></Grid>

                            <UniformGrid Columns="3" Margin="0,0,0,6"><StackPanel Margin="2"><TextBlock Text="Position X (m)"/><TextBox Text="{Binding NewLightSourcePosX, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleNumericConverter}}"/></StackPanel><StackPanel Margin="2"><TextBlock Text="Position Y (m)"/><TextBox Text="{Binding NewLightSourcePosY, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleNumericConverter}}"/></StackPanel><StackPanel Margin="2"><TextBlock Text="Position Z (m)"/><TextBox Text="{Binding NewLightSourcePosZ, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleNumericConverter}}"/></StackPanel></UniformGrid>
                            <UniformGrid Columns="3" Margin="0,0,0,6"><StackPanel Margin="2"><TextBlock Text="Rotation X (deg)"/><TextBox Text="{Binding NewLightSourceRotX, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleNumericConverter}}"/></StackPanel><StackPanel Margin="2"><TextBlock Text="Rotation Y (deg)"/><TextBox Text="{Binding NewLightSourceRotY, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleNumericConverter}}"/></StackPanel><StackPanel Margin="2"><TextBlock Text="Rotation Z (deg)"/><TextBox Text="{Binding NewLightSourceRotZ, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleNumericConverter}}"/></StackPanel></UniformGrid>
                            <UniformGrid Columns="2" Margin="0,0,0,6"><StackPanel Margin="2"><TextBlock Text="RayCount"/><TextBox Text="{Binding NewLightSourceRayCount}"/></StackPanel><StackPanel Margin="2"><TextBlock Text="TiltWeight"/><TextBox Text="{Binding NewLightSourceTiltWeight, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleNumericConverter}}"/></StackPanel></UniformGrid>
                            <UniformGrid Columns="3" Margin="0,0,0,6"><StackPanel Margin="2"><TextBlock Text="Tilt Point X (m)"/><TextBox Text="{Binding NewLightSourceTiltPointX, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleNumericConverter}}"/></StackPanel><StackPanel Margin="2"><TextBlock Text="Tilt Point Y (m)"/><TextBox Text="{Binding NewLightSourceTiltPointY, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleNumericConverter}}"/></StackPanel><StackPanel Margin="2"><TextBlock Text="Tilt Point Z (m)"/><TextBox Text="{Binding NewLightSourceTiltPointZ, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleNumericConverter}}"/></StackPanel></UniformGrid>

                            <GroupBox Header="Cylinder Parameters" Margin="0,0,0,6" Padding="6" Visibility="{Binding IsNewLightSourceCylinder, Converter={StaticResource BoolToVisibility}}">
                                <UniformGrid Columns="2"><StackPanel Margin="2"><TextBlock Text="Radius (m)"/><TextBox Text="{Binding NewLightSourceRadius, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleNumericConverter}}"/></StackPanel><StackPanel Margin="2"><TextBlock Text="Height (m)"/><TextBox Text="{Binding NewLightSourceHeight, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleNumericConverter}}"/></StackPanel></UniformGrid>
                            </GroupBox>

                            <GroupBox Header="Conical Frustum Parameters" Margin="0,0,0,6" Padding="6" Visibility="{Binding IsNewLightSourceConicalFrustum, Converter={StaticResource BoolToVisibility}}">
                                <UniformGrid Columns="3"><StackPanel Margin="2"><TextBlock Text="R1"/><TextBox Text="{Binding NewLightSourceRadiusStart, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleNumericConverter}}"/></StackPanel><StackPanel Margin="2"><TextBlock Text="R2"/><TextBox Text="{Binding NewLightSourceRadiusEnd, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleNumericConverter}}"/></StackPanel><StackPanel Margin="2"><TextBlock Text="Length (m)"/><TextBox Text="{Binding NewLightSourceLength, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleNumericConverter}}"/></StackPanel></UniformGrid>
                            </GroupBox>

                            <GroupBox Header="Circular Ogive Parameters" Margin="0,0,0,6" Padding="6" Visibility="{Binding IsNewLightSourceCircularOgive, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <UniformGrid Columns="4"><StackPanel Margin="2"><TextBlock Text="R1"/><TextBox Text="{Binding NewLightSourceRadiusStart, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleNumericConverter}}"/></StackPanel><StackPanel Margin="2"><TextBlock Text="R2"/><TextBox Text="{Binding NewLightSourceRadiusEnd, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleNumericConverter}}"/></StackPanel><StackPanel Margin="2"><TextBlock Text="Length (m)"/><TextBox Text="{Binding NewLightSourceLength, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleNumericConverter}}"/></StackPanel><StackPanel Margin="2"><TextBlock Text="Arc Radius (m)"/><TextBox Text="{Binding NewLightSourceArcRadius, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleNumericConverter}}"/></StackPanel></UniformGrid>
                                    <Grid Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="Ogive Curvature" VerticalAlignment="Center"/><ComboBox Grid.Column="1" ItemsSource="{Binding OgiveCurvatureDirections}" SelectedItem="{Binding NewLightSourceOgiveCurvatureDirection}"/></Grid>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="Hybrid Segments" Margin="0,0,0,6" Padding="6" Visibility="{Binding IsNewLightSourceHybrid, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <Button Content="Add Segment" Command="{Binding AddHybridSegmentCommand}" Width="110" Margin="0,0,8,0"/>
                                        <Button Content="Remove Selected Segment" Command="{Binding RemoveSelectedHybridSegmentCommand}" Width="170"/>
                                    </StackPanel>
                                    <ListBox ItemsSource="{Binding NewHybridSegments}" SelectedItem="{Binding SelectedNewHybridSegment}" DisplayMemberPath="Summary" Height="120" Margin="0,0,0,8"/>

                                    <GroupBox Header="Selected Segment" Padding="6">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="Type" VerticalAlignment="Center"/><ComboBox Grid.Column="1" ItemsSource="{Binding HybridSegmentKinds}" SelectedItem="{Binding SelectedNewHybridSegment.SegmentKind}"/></Grid>
                                            <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="Length (m)" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding SelectedNewHybridSegment.Length}"/></Grid>

                                            <StackPanel Visibility="{Binding SelectedNewHybridSegment.IsCylinder, Converter={StaticResource BoolToVisibility}}">
                                                <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="Radius (m)" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding SelectedNewHybridSegment.Radius}"/></Grid>
                                            </StackPanel>

                                            <StackPanel Visibility="{Binding SelectedNewHybridSegment.IsConicalFrustum, Converter={StaticResource BoolToVisibility}}">
                                                <UniformGrid Columns="2" Margin="0,0,0,6">
                                                    <StackPanel Margin="2"><TextBlock Text="R1"/><TextBox Text="{Binding SelectedNewHybridSegment.RadiusStart}" IsEnabled="{Binding SelectedNewHybridSegment.IsRadiusStartEditable}"/></StackPanel>
                                                    <StackPanel Margin="2"><TextBlock Text="R2"/><TextBox Text="{Binding SelectedNewHybridSegment.RadiusEnd}"/></StackPanel>
                                                </UniformGrid>
                                            </StackPanel>

                                            <StackPanel Visibility="{Binding SelectedNewHybridSegment.IsCircularOgive, Converter={StaticResource BoolToVisibility}}">
                                                <UniformGrid Columns="3"><StackPanel Margin="2"><TextBlock Text="R1"/><TextBox Text="{Binding SelectedNewHybridSegment.RadiusStart}" IsEnabled="{Binding SelectedNewHybridSegment.IsRadiusStartEditable}"/></StackPanel><StackPanel Margin="2"><TextBlock Text="R2"/><TextBox Text="{Binding SelectedNewHybridSegment.RadiusEnd}"/></StackPanel><StackPanel Margin="2"><TextBlock Text="Arc Radius (m)"/><TextBox Text="{Binding SelectedNewHybridSegment.ArcRadius}"/></StackPanel></UniformGrid>
                                                <Grid Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="Curvature" VerticalAlignment="Center"/><ComboBox Grid.Column="1" ItemsSource="{Binding OgiveCurvatureDirections}" SelectedItem="{Binding SelectedNewHybridSegment.OgiveCurvatureDirection}"/></Grid>
                                            </StackPanel>
                                        </StackPanel>
                                    </GroupBox>
                                </StackPanel>
                            </GroupBox>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Button Content="Add Source" Command="{Binding AddLightSourceCommand}" Width="95" Margin="0,0,8,0"/>
                                <Button Content="Regenerate Rays" Command="{Binding RegenerateLightSourceRaysCommand}" Width="120"/>
                            </StackPanel>
                            <GroupBox Header="Available Sources" Margin="0,8,0,0" Padding="6">
                                <StackPanel>
                                    <ListBox ItemsSource="{Binding AvailableSources}" SelectedItem="{Binding SelectedAvailableSource}" Height="130">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" />
                                                    <TextBlock Text=" | " />
                                                    <TextBlock Text="{Binding SourceType}" />
                                                    <TextBlock Text=" | " />
                                                    <TextBlock Text="{Binding RayCount, Mode=OneWay}" />
                                                    <TextBlock Text=" rays)" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <Button Content="Assign to Current Scene" Command="{Binding AssignSelectedAvailableSourceCommand}" Margin="0,6,0,0" Width="190" />
                                </StackPanel>
                            </GroupBox>
                            <GroupBox Header="Current Scene Source" Margin="0,8,0,0" Padding="6">
                                <StackPanel>
                                    <TextBlock Text="{Binding AssignedSceneSource.Name, TargetNullValue=No source assigned, Mode=OneWay}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <TextBlock Text="No source selected." Visibility="{Binding HasNoSourceSelection, Converter={StaticResource BoolToVisibility}}"/>
                                    <StackPanel Visibility="{Binding IsSelectedSourceEditable, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="{Binding SelectedObjectEditorType}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                        <TextBlock Text="Position (m)"/>
                                        <UniformGrid Columns="3" Margin="0,0,0,6"><StackPanel Margin="2"><TextBlock Text="X"/><TextBox Text="{Binding SelectedSourceEditPositionX, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleNumericConverter}}"/></StackPanel><StackPanel Margin="2"><TextBlock Text="Y"/><TextBox Text="{Binding SelectedSourceEditPositionY, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleNumericConverter}}"/></StackPanel><StackPanel Margin="2"><TextBlock Text="Z"/><TextBox Text="{Binding SelectedSourceEditPositionZ, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleNumericConverter}}"/></StackPanel></UniformGrid>
                                        <TextBlock Text="Rotation (deg)"/>
                                        <UniformGrid Columns="3" Margin="0,0,0,6"><StackPanel Margin="2"><TextBlock Text="X"/><TextBox Text="{Binding SelectedSourceEditRotationX, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleNumericConverter}}"/></StackPanel><StackPanel Margin="2"><TextBlock Text="Y"/><TextBox Text="{Binding SelectedSourceEditRotationY, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleNumericConverter}}"/></StackPanel><StackPanel Margin="2"><TextBlock Text="Z"/><TextBox Text="{Binding SelectedSourceEditRotationZ, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleNumericConverter}}"/></StackPanel></UniformGrid>
                                        <Button Content="Apply Source Changes" Command="{Binding ApplySelectedSourceChangesCommand}" Width="150"/>
                                    </StackPanel>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Actions" Margin="0,0,0,8" Padding="8">
                        <StackPanel>
                            <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="Algorithm" VerticalAlignment="Center"/><ComboBox Grid.Column="1" ItemsSource="{Binding CollisionAlgorithms}" SelectedItem="{Binding SelectedCollisionAlgorithm}" /></Grid>
                            <StackPanel Orientation="Horizontal"><Button Content="Run Collision" Command="{Binding RunCollisionCommand}" Width="120" Height="30" Margin="0,0,8,0"/><Button Content="Export Hit Points CSV" Command="{Binding ExportHitPointsCsvCommand}" Width="160" Height="30" Margin="0,0,8,0"/><Button Content="Reset Demo Scene" Command="{Binding ResetDemoSceneCommand}" Width="140" Height="30"/></StackPanel>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Results" Padding="8">
                        <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="#444"/>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <TabControl Grid.Column="1">
          <TabItem Header="Scene View">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <Border Padding="8,5" Background="#F8FAFC" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="Display:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                  <CheckBox Content="Collision Rays" IsChecked="{Binding SelectedScene.ShowCollisionRays, Mode=TwoWay}" Margin="0,0,14,0"/>
                  <CheckBox Content="Collision Hit Points" IsChecked="{Binding SelectedScene.ShowCollisionHitPoints, Mode=TwoWay}"/>
                </StackPanel>
              </Border>
            <h:HelixViewport3D Grid.Row="1" x:Name="Viewport" ShowCoordinateSystem="True" ShowViewCube="True" ZoomExtentsWhenLoaded="True">
                <h:HelixViewport3D.Camera>
                    <PerspectiveCamera Position="0,-30,30" LookDirection="0,30,-30" UpDirection="0,0,1" FieldOfView="45" />
                </h:HelixViewport3D.Camera>
                <h:SunLight />
                <h:GridLinesVisual3D Width="120" Length="120" MinorDistance="5" MajorDistance="10" />
            </h:HelixViewport3D>
            </Grid>
          </TabItem>
          <TabItem Header="Collision Results"><views:CollisionResultsView/></TabItem>
        </TabControl>
        <Border Grid.ColumnSpan="2" Background="#AAFFFFFF" Visibility="{Binding IsCollisionProgressVisible, Converter={StaticResource BoolToVisibility}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="420">
                <TextBlock Text="Running collision" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding CollisionProgressMessage}" Margin="0,12" TextAlignment="Center"/>
                <ProgressBar x:Name="CollisionProgressBar"
                             Height="18"
                             Minimum="0"
                             Maximum="100"
                             Value="{Binding CollisionProgressPercent, Mode=OneWay}"
                             IsIndeterminate="{Binding CollisionProgressIsIndeterminate, Mode=OneWay}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
