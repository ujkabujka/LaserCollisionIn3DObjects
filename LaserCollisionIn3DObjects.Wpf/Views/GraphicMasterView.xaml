<UserControl x:Class="LaserCollisionIn3DObjects.Wpf.Views.GraphicMasterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:oxy="http://oxyplot.org/wpf"
             xmlns:conv="clr-namespace:LaserCollisionIn3DObjects.Wpf.Converters"
             mc:Ignorable="d">
    <UserControl.Resources>
        <conv:FlexibleNumericConverter x:Key="FlexibleNumericConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Padding="12" BorderBrush="#D8D8D8" BorderThickness="0,0,1,0" Background="#FAFAFA">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Graphic Master" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,10" />

                    <GroupBox Header="Graph Type" Margin="0,0,0,8" Padding="8">
                        <StackPanel>
                            <ComboBox ItemsSource="{Binding GraphicMasterWorkspace.GraphTypes}"
                                      SelectedItem="{Binding GraphicMasterWorkspace.SelectedGraphType}"
                                      DisplayMemberPath="DisplayName"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Chart" Margin="0,0,0,8" Padding="8">
                        <StackPanel>
                            <TextBlock Text="Chart Name"/>
                            <TextBox Text="{Binding GraphicMasterWorkspace.ChartName, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Graph Sources" Margin="0,0,0,8" Padding="8">
                        <StackPanel>
                            <TextBlock TextWrapping="Wrap" Foreground="#555" Margin="0,0,0,6"
                                       Text="Select scene, completed, projection, or independently imported sources."/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Button Content="Import Source File" Command="{Binding GraphicMasterWorkspace.ImportSourceCommand}" Margin="0,0,6,0"/>
                                <Button Content="Remove Imported" Command="{Binding GraphicMasterWorkspace.RemoveImportedSourceCommand}"/>
                            </StackPanel>
                            <ListBox ItemsSource="{Binding GraphicMasterWorkspace.Sources}"
                                     SelectedItem="{Binding GraphicMasterWorkspace.SelectedSource}"
                                     Height="280" BorderThickness="1" BorderBrush="#D1D5DB">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected}" Content="{Binding DisplayName}" Margin="2"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Parameters" Margin="0,0,0,8" Padding="8">
                        <StackPanel>
                            <StackPanel>
                                <TextBlock Text="Angle Bin Size (deg)"/>
                                <TextBox Text="{Binding GraphicMasterWorkspace.AngleBinSizeDeg, Converter={StaticResource FlexibleNumericConverter}, UpdateSourceTrigger=LostFocus}"/>
                            </StackPanel>
                            <StackPanel Visibility="{Binding GraphicMasterWorkspace.ShowsAzimuthBinSize, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="Azimuth Bin Size (deg)" Margin="0,6,0,0"/>
                                <TextBox Text="{Binding GraphicMasterWorkspace.AzimuthBinSizeDeg, Converter={StaticResource FlexibleNumericConverter}, UpdateSourceTrigger=LostFocus}"/>
                            </StackPanel>
                            <StackPanel Visibility="{Binding GraphicMasterWorkspace.ShowsPolarBinSize, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="Polar Bin Size (deg)" Margin="0,6,0,0"/>
                                <TextBox Text="{Binding GraphicMasterWorkspace.PolarBinSizeDeg, Converter={StaticResource FlexibleNumericConverter}, UpdateSourceTrigger=LostFocus}"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                    <Button Content="Generate Chart"
                            Command="{Binding GraphicMasterWorkspace.GenerateChartCommand}"
                            Height="32"/>
                    <Button Content="Focus Y"
                            Command="{Binding GraphicMasterWorkspace.FocusYCommand}"
                            Margin="0,6,0,0"
                            Visibility="{Binding GraphicMasterWorkspace.CanFocusY, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <GroupBox Header="Angle Histogram Similarity" Margin="0,8,0,0" Padding="8">
                        <StackPanel>
                            <TextBlock Text="Uses the current Angle Bin Size and selected graph sources."
                                       TextWrapping="Wrap" Foreground="#555" Margin="0,0,0,6"/>
                            <Button Content="Compare Selected Sources"
                                    Command="{Binding GraphicMasterWorkspace.CompareSelectedSourcesCommand}"
                                    Height="32"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Stored Charts" Margin="0,8,0,8" Padding="8">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="Delete Selected"
                                        Command="{Binding GraphicMasterWorkspace.DeleteStoredChartCommand}"
                                        Margin="0,0,8,0"/>
                                <Button Content="Save Current as PNG"
                                        Command="{Binding GraphicMasterWorkspace.SaveChartAsPngCommand}"/>
                            </StackPanel>
                            <ListBox ItemsSource="{Binding GraphicMasterWorkspace.StoredCharts}"
                                     SelectedItem="{Binding GraphicMasterWorkspace.SelectedStoredChart}"
                                     Height="180"
                                     DisplayMemberPath="DisplayName"
                                     BorderThickness="1"
                                     BorderBrush="#D1D5DB"/>
                        </DockPanel>
                    </GroupBox>

                    <TextBlock Margin="0,8,0,0"
                               Foreground="#374151"
                               TextWrapping="Wrap"
                               Text="{Binding GraphicMasterWorkspace.StatusMessage}"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Column="1" Padding="12" Background="White">
            <TabControl x:Name="WorkspaceTabs">
                <TabItem Header="Chart" x:Name="ChartTab">
                    <oxy:PlotView x:Name="ChartPlotView"
                                  Model="{Binding GraphicMasterWorkspace.PlotModel}" />
                </TabItem>
                <TabItem Header="Similarity" x:Name="SimilarityTab">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <StackPanel Margin="12" MinWidth="600">
                            <TextBlock Text="Angle Histogram Similarity" FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding GraphicMasterWorkspace.SimilarityBinSizeText}"
                                       FontWeight="SemiBold" Margin="0,4,0,8"/>
                            <TextBlock Text="Similarity compares the shape of the angle-bin distributions. 1 means identical histogram shape; values closer to 0 indicate greater difference. Results depend on Angle Bin Size."
                                       TextWrapping="Wrap" Foreground="#555" MaxWidth="900" HorizontalAlignment="Left"/>

                            <StackPanel Margin="0,12,0,12" Orientation="Horizontal">
                                <TextBlock Text="Metric:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox x:Name="SimilarityMetricSelector"
                                          ItemsSource="{Binding GraphicMasterWorkspace.SimilarityMetrics}"
                                          SelectedItem="{Binding GraphicMasterWorkspace.SelectedSimilarityMetric}"
                                          DisplayMemberPath="DisplayName" MinWidth="220"/>
                            </StackPanel>

                            <Border BorderBrush="#D1D5DB" BorderThickness="1" Padding="10" Margin="0,0,0,12"
                                    Visibility="{Binding GraphicMasterWorkspace.ShowsTwoSourceSummary, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Source A:" FontWeight="SemiBold"/><TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding GraphicMasterWorkspace.SimilaritySourceA}"/>
                                    <TextBlock Grid.Row="1" Text="Source B:" FontWeight="SemiBold"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding GraphicMasterWorkspace.SimilaritySourceB}"/>
                                    <TextBlock Grid.Row="2" Text="Cosine Similarity:"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding GraphicMasterWorkspace.SimilarityCosine}"/>
                                    <TextBlock Grid.Row="3" Text="Histogram Intersection:"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding GraphicMasterWorkspace.SimilarityIntersection}"/>
                                    <TextBlock Grid.Row="4" Text="Jensen-Shannon Similarity:"/><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding GraphicMasterWorkspace.SimilarityJensenShannon}"/>
                                </Grid>
                            </Border>

                            <DataGrid x:Name="SimilarityMatrixGrid"
                                      ItemsSource="{Binding GraphicMasterWorkspace.SimilarityMatrix}"
                                      AutoGenerateColumns="True" IsReadOnly="True" CanUserAddRows="False"
                                      HeadersVisibility="All" Margin="0,0,0,16" MaxHeight="360"
                                      Visibility="{Binding GraphicMasterWorkspace.ShowsSimilarityMatrix, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                            <TextBlock Text="Pairwise details" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <DataGrid x:Name="SimilarityPairDetailsGrid"
                                      ItemsSource="{Binding GraphicMasterWorkspace.SimilarityPairs}"
                                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MinHeight="160">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Source A" Binding="{Binding SourceA}" Width="*"/>
                                    <DataGridTextColumn Header="Source B" Binding="{Binding SourceB}" Width="*"/>
                                    <DataGridTextColumn Header="Cosine" Binding="{Binding Cosine}" Width="110"/>
                                    <DataGridTextColumn Header="Intersection" Binding="{Binding Intersection}" Width="110"/>
                                    <DataGridTextColumn Header="JS Similarity" Binding="{Binding JensenShannon}" Width="120"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Border>
    </Grid>
</UserControl>
