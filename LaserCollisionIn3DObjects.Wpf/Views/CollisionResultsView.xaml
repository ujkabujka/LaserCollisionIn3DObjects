<UserControl x:Class="LaserCollisionIn3DObjects.Wpf.Views.CollisionResultsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:oxy="http://oxyplot.org/wpf"
             xmlns:conv="clr-namespace:LaserCollisionIn3DObjects.Wpf.Converters">
    <UserControl.Resources><conv:PanelResultLabelConverter x:Key="PanelResultLabelConverter"/></UserControl.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock FontSize="17" FontWeight="SemiBold">
                <Run Text="Scene: "/><Run Text="{Binding SelectedScene.PanelAnalysis.SceneName, Mode=OneWay}"/>
                <Run Text=" | Rays tested: "/><Run Text="{Binding SelectedScene.PanelAnalysis.TotalRaysTested, Mode=OneWay}"/>
                <Run Text=" | Hits: "/><Run Text="{Binding SelectedScene.PanelAnalysis.TotalHits, Mode=OneWay}"/>
                <Run Text=" | Panels hit: "/><Run Text="{Binding SelectedScene.PanelAnalysis.PanelsHit, Mode=OneWay}"/>
                <Run Text=" / "/><Run Text="{Binding SelectedScene.PanelAnalysis.Panels.Count, Mode=OneWay}"/>
            </TextBlock>
            <StackPanel Orientation="Horizontal" Margin="0,8">
                <Button Content="Export Results CSV" Command="{Binding ExportHitPointsCsvCommand}" Margin="0,0,8,0" Padding="10,5"/>
                <Button Content="Save Selected Panel Image" Command="{Binding SaveSelectedPanelImageCommand}" Padding="10,5"/>
            </StackPanel>
        </StackPanel>
        <TabControl Grid.Row="1">
            <TabItem Header="By Panel">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <ListBox ItemsSource="{Binding SelectedScene.PanelResults, Mode=OneWay}" SelectedItem="{Binding SelectedScene.SelectedPanelResult}">
                        <ListBox.ItemTemplate><DataTemplate><TextBlock Margin="3"><TextBlock.Text><MultiBinding Converter="{StaticResource PanelResultLabelConverter}" Mode="OneWay"><Binding Path="DataContext.SelectedScene.SceneOrdinal" RelativeSource="{RelativeSource AncestorType=UserControl}" Mode="OneWay"/><Binding Path="PanelName" Mode="OneWay"/><Binding Path="HitCount" Mode="OneWay"/></MultiBinding></TextBlock.Text></TextBlock></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions><RowDefinition Height="2*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <oxy:PlotView Model="{Binding SelectedScene.PanelPlotModel, Mode=OneWay}"/>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding SelectedScene.SelectedPanelResult.Hits, Mode=OneWay}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding PanelHitIndex, Mode=OneWay}" Width="45"/>
                                <DataGridTextColumn Header="Local Y (m)" Binding="{Binding LocalY, StringFormat=F3, Mode=OneWay}" Width="90"/>
                                <DataGridTextColumn Header="Local Z (m)" Binding="{Binding LocalZ, StringFormat=F3, Mode=OneWay}" Width="90"/>
                                <DataGridTextColumn Header="Source Type" Binding="{Binding SourceType, Mode=OneWay}" Width="180"/>
                                <DataGridTextColumn Header="Source Name" Binding="{Binding SourceName, Mode=OneWay}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="By Ray">
                <DataGrid ItemsSource="{Binding HitResults}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
                    <DataGrid.Columns><DataGridTextColumn Header="Ray" Binding="{Binding RayLabel}" Width="70"/><DataGridTextColumn Header="Source" Binding="{Binding SourceName}" Width="*"/><DataGridTextColumn Header="Type" Binding="{Binding SourceType}" Width="160"/><DataGridCheckBoxColumn Header="Hit" Binding="{Binding HasHit}" Width="45"/><DataGridTextColumn Header="Distance" Binding="{Binding Distance, StringFormat=F3}" Width="85"/><DataGridTextColumn Header="Panel" Binding="{Binding PrismName}" Width="*"/></DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
