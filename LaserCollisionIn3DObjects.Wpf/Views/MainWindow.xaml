<Window x:Class="LaserCollisionIn3DObjects.Wpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:behaviors="clr-namespace:LaserCollisionIn3DObjects.Wpf.Behaviors"
        xmlns:conv="clr-namespace:LaserCollisionIn3DObjects.Wpf.Converters"
        xmlns:vm="clr-namespace:LaserCollisionIn3DObjects.Wpf.ViewModels"
        xmlns:services="clr-namespace:LaserCollisionIn3DObjects.Wpf.Services"
        xmlns:v="clr-namespace:LaserCollisionIn3DObjects.Wpf.Views"
        xmlns:sourceCompletion="clr-namespace:LaserCollisionIn3DObjects.Wpf.Features.SourceCompletion.Views"
        xmlns:controls="clr-namespace:LaserCollisionIn3DObjects.Wpf.Controls"
        mc:Ignorable="d"
        Title="{Binding Title}"
        Width="1500"
        Height="900"
        MinWidth="1200"
        MinHeight="760">
    <Window.Resources>
        <conv:FlexibleNumericConverter x:Key="FlexibleNumericConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <Style x:Key="NavigationButtonBaseStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#1F2937"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter Margin="2"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#E5E7EB"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#D1D5DB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavigationLabelStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="10,0,0,0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsNavigationCollapsed}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HamburgerToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="8,8,8,6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#EEF2FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ConsoleItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="4,2"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="{x:Static services:ApplicationLogLevel.Warning}">
                    <Setter Property="Foreground" Value="#B45309"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="{x:Static services:ApplicationLogLevel.Error}">
                    <Setter Property="Foreground" Value="#B91C1C"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="{x:Static services:ApplicationLogLevel.Success}">
                    <Setter Property="Foreground" Value="#166534"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="Save Project" Command="{Binding SaveProjectCommand}"/>
                <MenuItem Header="Load Project" Command="{Binding LoadProjectCommand}"/>
                <Separator/>
                <MenuItem Header="Export Light Source..." Command="{Binding ExportLightSourceCommand}"/>
                <MenuItem Header="Import Light Source..." Command="{Binding ImportLightSourceCommand}"/>
                <Separator/>
                <MenuItem Header="Save Collision View State" Command="{Binding SaveCollisionTabCommand}"/>
                <MenuItem Header="Load Collision View State" Command="{Binding LoadCollisionTabCommand}"/>
                <MenuItem Header="Save Annotation View State" Command="{Binding SaveAnnotationTabCommand}"/>
                <MenuItem Header="Load Annotation View State" Command="{Binding LoadAnnotationTabCommand}"/>
                <MenuItem Header="Save Projection View State" Command="{Binding SaveProjectionTabCommand}"/>
                <MenuItem Header="Load Projection View State" Command="{Binding LoadProjectionTabCommand}"/>
                <Separator/>
                <MenuItem Header="E_xit" Command="ApplicationCommands.Close" CommandTarget="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="{Binding ConsoleVisibilityMenuText}" Command="{Binding ToggleConsoleCommand}"/>
            </MenuItem>
            <MenuItem Header="_Tools"/>
            <MenuItem Header="_Help"/>
        </Menu>

        <Grid DockPanel.Dock="Bottom"
              Height="190"
              MinHeight="120"
              Background="#F8FAFC"
              Visibility="{Binding IsConsoleVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#E2E8F0" BorderBrush="#CBD5E1" BorderThickness="0,1,0,1" Padding="8,4">
                <DockPanel>
                    <TextBlock Text="Console" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Copy" Command="{Binding CopyConsoleCommand}" Padding="10,2" Margin="0,0,6,0"/>
                        <Button Content="Clear" Command="{Binding ClearConsoleCommand}" Padding="10,2" Margin="0,0,6,0"/>
                        <Button Content="Close" Command="{Binding HideConsoleCommand}" Padding="10,2"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <ListBox Grid.Row="1"
                     ItemsSource="{Binding ConsoleEntries}"
                     FontFamily="Consolas"
                     FontSize="12"
                     BorderThickness="0"
                     ItemContainerStyle="{StaticResource ConsoleItemStyle}"
                     behaviors:AutoScrollBehavior.AutoScrollToEnd="True">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type services:ApplicationLogEntry}">
                        <TextBlock TextWrapping="Wrap">
                            <Run Text="["/>
                            <Run Text="{Binding Timestamp, StringFormat=HH:mm:ss}"/>
                            <Run Text="] ["/>
                            <Run Text="{Binding Level}"/>
                            <Run Text="] "/>
                            <Run Text="{Binding Source, StringFormat=({0}) }"/>
                            <Run Text="{Binding Message}"/>
                            <Run Text="{Binding ExceptionText, StringFormat= | {0}}"/>
                        </TextBlock>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#E5E7EB" BorderThickness="0,0,1,0">
                <Grid Width="{Binding NavigationRailWidth}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <ToggleButton Grid.Row="0"
                                  Style="{StaticResource HamburgerToggleStyle}"
                                  Content="☰"
                                  IsChecked="{Binding IsNavigationCollapsed}"
                                  ToolTip="Collapse navigation"/>

                    <StackPanel Grid.Row="1" Margin="8,4,8,8">
                        <Button Command="{Binding ShowCollisionWorkspaceCommand}"
                                Margin="0,0,0,6">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavigationButtonBaseStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedWorkspace}" Value="{x:Static vm:WorkspaceKind.Collision}">
                                            <Setter Property="Background" Value="#DBEAFE"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚙" FontSize="14" VerticalAlignment="Center"/>
                                <TextBlock Text="Collision" Style="{StaticResource NavigationLabelStyle}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding ShowAnnotationWorkspaceCommand}"
                                Margin="0,0,0,6">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavigationButtonBaseStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedWorkspace}" Value="{x:Static vm:WorkspaceKind.Annotation}">
                                            <Setter Property="Background" Value="#DBEAFE"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🖼" FontSize="14" VerticalAlignment="Center"/>
                                <TextBlock Text="Annotation" Style="{StaticResource NavigationLabelStyle}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding ShowProjectionWorkspaceCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavigationButtonBaseStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedWorkspace}" Value="{x:Static vm:WorkspaceKind.Projection}">
                                            <Setter Property="Background" Value="#DBEAFE"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📐" FontSize="14" VerticalAlignment="Center"/>
                                <TextBlock Text="Projection" Style="{StaticResource NavigationLabelStyle}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding ShowGraphicMasterWorkspaceCommand}"
                                Margin="0,6,0,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavigationButtonBaseStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedWorkspace}" Value="{x:Static vm:WorkspaceKind.GraphicMaster}">
                                            <Setter Property="Background" Value="#DBEAFE"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📊" FontSize="14" VerticalAlignment="Center"/>
                                <TextBlock Text="Graphic Master" Style="{StaticResource NavigationLabelStyle}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding ShowSourceCompletionWorkspaceCommand}"
                                Margin="0,6,0,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavigationButtonBaseStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedWorkspace}" Value="{x:Static vm:WorkspaceKind.SourceCompletion}">
                                            <Setter Property="Background" Value="#DBEAFE"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🧩" FontSize="14" VerticalAlignment="Center"/>
                                <TextBlock Text="Source Completion" Style="{StaticResource NavigationLabelStyle}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <v:CollisionWorkspaceView x:Name="CollisionWorkspaceView" DataContext="{Binding}">
                    <v:CollisionWorkspaceView.Style>
                        <Style TargetType="v:CollisionWorkspaceView">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedWorkspace}" Value="{x:Static vm:WorkspaceKind.Collision}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </v:CollisionWorkspaceView.Style>
                </v:CollisionWorkspaceView>

                <v:AnnotationWorkspaceView DataContext="{Binding}">
                    <v:AnnotationWorkspaceView.Style>
                        <Style TargetType="v:AnnotationWorkspaceView">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedWorkspace}" Value="{x:Static vm:WorkspaceKind.Annotation}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </v:AnnotationWorkspaceView.Style>
                </v:AnnotationWorkspaceView>

                <v:ProjectionWorkspaceView x:Name="ProjectionWorkspaceView" DataContext="{Binding}">
                    <v:ProjectionWorkspaceView.Style>
                        <Style TargetType="v:ProjectionWorkspaceView">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedWorkspace}" Value="{x:Static vm:WorkspaceKind.Projection}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </v:ProjectionWorkspaceView.Style>
                </v:ProjectionWorkspaceView>

                <v:GraphicMasterView DataContext="{Binding}">
                    <v:GraphicMasterView.Style>
                        <Style TargetType="v:GraphicMasterView">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedWorkspace}" Value="{x:Static vm:WorkspaceKind.GraphicMaster}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </v:GraphicMasterView.Style>
                </v:GraphicMasterView>
            
                <sourceCompletion:SourceCompletionWorkspaceView DataContext="{Binding}">
                    <sourceCompletion:SourceCompletionWorkspaceView.Style>
                        <Style TargetType="sourceCompletion:SourceCompletionWorkspaceView">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedWorkspace}" Value="{x:Static vm:WorkspaceKind.SourceCompletion}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </sourceCompletion:SourceCompletionWorkspaceView.Style>
                </sourceCompletion:SourceCompletionWorkspaceView>
            </Grid>
            <controls:BusyOverlay Grid.ColumnSpan="2" Panel.ZIndex="1000"
                                  Visibility="{Binding IsIoBusy, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"
                                  Message="{Binding IoBusyMessage, Mode=OneWay}"
                                  IsIndeterminate="True" Progress="0"/>
        </Grid>
    </DockPanel>
</Window>
